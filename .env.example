# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit credentials.

# --- Google Sheets / Service Account ---
# Path to the service-account JSON key file (see config/README.md and docs/setup.md).
GOOGLE_APPLICATION_CREDENTIALS=config/credentials.json

# Service account email — for convenience / sharing target sheets.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# --- Source spreadsheets ---
# Employee master sheet (used by qr_generator).
# GID is the number after `#gid=` in the sheet URL (the specific worksheet tab).
EMPLOYEE_SHEET_ID=your-employee-spreadsheet-id
EMPLOYEE_SHEET_GID=0

# Practice 1 time log sheet (used by time_reporter).
# Columns expected: Date | Employee | Time_in | Time_out | Total_hours
TIME_LOG_SHEET_ID=your-time-log-spreadsheet-id
TIME_LOG_SHEET_GID=0

# --- n8n ---
# The workflow that turns a QR scan into a row in the time log lives in n8n,
# not in this repo. These let the tooling read it through n8n's public API
# (auth header is `X-N8N-API-KEY`, endpoints live under <base>/api/v1).

# Instance base URL, no trailing slash.
# Cloud looks like https://your-name.app.n8n.cloud — self-hosted is your host.
N8N_BASE_URL=https://your-name.app.n8n.cloud

# Settings → n8n API → Create an API key. Treat it like a password.
N8N_API_KEY=your-n8n-api-key

# Optional: the timelog workflow's ID, from the URL when it's open
# (…/workflow/<THIS>). Saves having to list every workflow to find it.
N8N_WORKFLOW_ID=

# --- Output ---
# Override default output directory if desired (relative to project root).
OUTPUT_DIR=output

# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit credentials.

# --- Google Sheets / Service Account ---
# Path to the service-account JSON key file (see config/README.md and docs/setup.md).
GOOGLE_APPLICATION_CREDENTIALS=config/credentials.json

# Service account email — for convenience / sharing target sheets.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# --- Source spreadsheets ---
# Employee master sheet (used by qr_generator).
# GID is the number after `#gid=` in the sheet URL (the specific worksheet tab).
EMPLOYEE_SHEET_ID=your-employee-spreadsheet-id
EMPLOYEE_SHEET_GID=0

# Practice 1 time log sheet (used by time_reporter).
# Columns expected: Date | Employee | Time_in | Time_out | Total_hours
TIME_LOG_SHEET_ID=your-time-log-spreadsheet-id
TIME_LOG_SHEET_GID=0

# --- Output ---
# Override default output directory if desired (relative to project root).
OUTPUT_DIR=output
